# Variáveis de Ambiente — Auto Zap ARIA

# ===== OBRIGATÓRIO =====

# OpenAI API Key — obter em https://platform.openai.com/
OPENAI_API_KEY=sk-proj-yNy-...

# Google Sheets App Script URL — publicar em Extensões > Apps Script > Implantar > App da Web
GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwXtTD0pqB0mL6FUkWsYTVLoulQIteSRz9dhiX5wK9sRfhM0vKbtQaaj5bq6zeiFZYT/exec
# ===== WHATSAPP =====

# ID único para esta instância do WhatsApp (usado pelo LocalAuth para salvar sessão)
WA_CLIENT_ID=samantha-main

# ===== OPENAI API =====

# Modelo a usar (gpt-4o-mini = o mais em conta e ideal para chatbot)
OPENAI_MODEL=gpt-4o-mini

# Máximo de tokens por resposta (512 = respostas concisas para WhatsApp)
OPENAI_MAX_TOKENS=512

# ===== SESSÕES =====

# Máximo de mensagens no histórico por sessão (mais = mais contexto, mais tokens)
MAX_HISTORY_MESSAGES=20

# Timeout de inatividade antes de limpar histórico da sessão (ms)
# 1800000 = 30 minutos
SESSION_TIMEOUT_MS=1800000

# Tempo padrão de silenciamento do bot após takeover humano em minutos
HUMAN_TAKEOVER_COOLDOWN_MIN=30

# ===== RATE LIMITING =====

# Máximo de mensagens aceitas por janela de tempo (por número)
# Phase 5: reduzido para 5 msg/min (mais seguro contra spam)
RATE_LIMIT_MAX=5

# Janela de tempo do rate limit em ms (60000 = 1 minuto)
RATE_LIMIT_WINDOW_MS=60000

# ===== CACHE GOOGLE SHEETS =====

# TTL do cache para dados estáticos (produtos, filiais, etc.) em ms
# 900000 = 15 minutos
SHEETS_CACHE_TTL_MS=900000

# TTL do cache para dados do sistema/empresa em ms
# 3600000 = 1 hora
SHEETS_SYSTEM_CACHE_TTL_MS=3600000

# ===== LOGGING =====

# Nível de log: error | warn | info | debug
LOG_LEVEL=info

# ===== AMBIENTE =====

# development | production
NODE_ENV=development

# ===== FILA DE MENSAGENS (Phase 5) =====

# Delay mínimo antes de enviar resposta em ms (simula tempo de digitação)
MSG_DELAY_MIN_MS=1000

# Delay máximo antes de enviar resposta em ms
MSG_DELAY_MAX_MS=3000

# ===== NOTIFICAÇÕES ADMIN (Phase 5) =====

# Número do administrador que recebe alertas do bot via WhatsApp
# Formato: código do país + número SEM @c.us (ex: 5959812345678 para Paraguai)
ADMIN_PHONE=

# ===== HEALTH CHECK SERVER (Phase 5) =====

# Porta do servidor HTTP de monitoramento
HEALTH_PORT=8080

# Token de autenticação para o endpoint /health
# Gere um valor aleatório seguro (ex: uuid ou openssl rand -hex 32)
HEALTH_TOKEN=

# ===== META / INSTAGRAM INTEGRATION (Phase 7+) =====

# Token de verificação customizado para validação do Webhook na Meta Developer Suite
META_VERIFY_TOKEN=samantha_insta_verify_2026

# Chave Secreta do Aplicativo Meta (App Secret) para verificação de assinaturas HMAC-SHA256
META_APP_SECRET=

